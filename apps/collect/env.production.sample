# Environment: development | preview | production.
# Use preview/staging until the mobile ingestion API has passed E2E verification.
EXPO_PUBLIC_ENVIRONMENT=production

# Staging mobile ingestion API. Do not use the live Elastic Beanstalk production API for development.
EXPO_PUBLIC_API_BASE_URL=https://staging-api.mkulimascore.com

# Optional numeric institution id override.
# If blank, the app uses the authenticated user's institution_id, then the login orgId if numeric.
EXPO_PUBLIC_MKULIMASCORE_INSTITUTION_ID=

EXPO_PUBLIC_API_TIMEOUT_MS=30000
EXPO_PUBLIC_APP_VERSION=0.1.0
EXPO_PUBLIC_MAP_TILE_SOURCE=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_APP_NAME=MkulimaCollect

# Backend/operator aliases for deployment documentation.
MKULIMA_ENV=staging
MKULIMA_API_BASE_URL=https://staging.api.mkulimascore.com/api/v1
MKULIMA_UPLOAD_BUCKET_CONTEXT=staging
MKULIMA_SYNC_BATCH_SIZE=100
MKULIMA_OFFLINE_MODE=true
